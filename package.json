{
  "name": "42trees-license-manager",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf:typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate": "wrangler d1 migrations apply license_mgmt --local",
    "db:rm": "rm -rf .wrangler/state/v3/d1",
    "test": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "keys:gen": "bun scripts/generate-jwt-key.mts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "es-toolkit": "^1.52.0",
    "hono": "^4.13.7",
    "ky": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.5",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/node": "^26.6.1",
    "@vitest/coverage-istanbul": "^5.1.1",
    "lefthook": "^2.2.2",
    "msw": "^3.0.7",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "packageManager": "bun@1.4.4"
}
