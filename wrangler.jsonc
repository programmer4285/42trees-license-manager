{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "42trees-license-manager",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,

  "vars": {
    "TOKEN_ISSUER": "42trees",
    "TOKEN_TTL_SECONDS": "2592000",
    "SEAT_LIMIT": "3",
  },

  "secrets": {
    "required": ["JWT_PRIVATE_KEY"],
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "license_mgmt",
      "database_id": "REPLACE_AFTER_WRANGLER_D1_CREATE",
    },
  ],

  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],

  "observability": {
    "enabled": true,
    "logs": {
      // Capture 100% of logs — lower this for high-traffic Workers
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01, // Sample 1% of traces
    },
  },
}
